{
    "name": "bus-lens-rs485-workbench",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "tsx server/main.ts",
        "dev": "tsx server/main.ts --dev",
        "dev:ui": "vite --configLoader runner --host 127.0.0.1 --port 4173",
        "dev:server": "tsx server/main.ts --dev --server-only",
        "build": "pnpm run typecheck && vite build --configLoader runner",
        "test": "node --test tests/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
        "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 4173"
    },
    "dependencies": {
        "@tanstack/virtual-core": "^3.17.6",
        "better-sqlite3": "^13.0.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "tsx": "^4.23.8",
        "typescript": "^7.0.2",
        "vite": "^8.1.5"
    }
}
